# MySQL 5.7.44 整合优化配置 - 修正版
# 适配：Docker容器化部署

[client]
default-character-set = utf8mb4
connect-timeout = 10

[mysql]
default-character-set = utf8mb4

[mysqld]
# ===================== 基础核心配置 =====================
bind-address = 0.0.0.0
skip-name-resolve
# 注意：此项仅在从零初始化数据库时生效，若挂载旧数据卷需与旧配置保持一致
lower-case-table-names = 1
default-storage-engine = InnoDB
transaction-isolation = REPEATABLE-READ
sql_mode = NO_ENGINE_SUBSTITUTION,STRICT_TRANS_TABLES

# ===================== 复制与日志配置 =====================
server-id = 1
# 显式禁止二进制日志（5.7默认通常为关闭，此处强制禁用以节省空间）
skip-log-bin
# 如果需要开启 Binlog，请注释掉上面一行，并取消下面两行的注释：
# log_bin = mysql-bin
# expire_logs_days = 7

# ===================== 字符集全链路配置 =====================
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
init_connect = 'SET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci'
skip-character-set-client-handshake

# ===================== 连接与会话性能配置 =====================
max_connections = 10000
max_user_connections = 9999
max_connect_errors = 100000
# 缩短超时时间，回收空闲连接
wait_timeout = 600
interactive_timeout = 600
thread_cache_size = 100

# ===================== 缓存与文件IO配置 =====================
table_open_cache = 2000
# 容器启动时需确保 --ulimit nofile=65535:65535
open_files_limit = 65535
max_allowed_packet = 64M
tmp_table_size = 64M
max_heap_table_size = 64M

# ===================== InnoDB 存储引擎核心优化 =====================
# 关键：根据容器限制调整。建议设置为容器最大内存的 50%-70%
innodb_buffer_pool_size = 1G
innodb_log_file_size = 256M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1
innodb_log_buffer_size = 16M
innodb_lock_wait_timeout = 50

# ===================== 日志与运维配置 =====================
slow_query_log = 1
# 日志文件将保存在数据卷中
slow_query_log_file = /var/lib/mysql/mysql-slow.log
long_query_time = 2
log_error = /var/lib/mysql/mysqld-error.log