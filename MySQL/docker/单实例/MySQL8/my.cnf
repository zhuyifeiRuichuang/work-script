[client]
default-character-set = utf8mb4
port = 3306
socket = /var/run/mysqld/mysqld.sock

[mysql]
default-character-set = utf8mb4
# 禁止自动补全，生产环境避免意外执行
no-auto-rehash

[mysqld]
# ============================================================
#  基础设置
# ============================================================
user = mysql
port = 3306
socket = /var/run/mysqld/mysqld.sock
pid-file = /var/run/mysqld/mysqld.pid

# 字符集 — 生产统一 utf8mb4，排序规则使用 MySQL 8 默认
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci

# 目录
datadir = /var/lib/mysql
tmpdir = /tmp

# 时区 — 固定东八区，避免夏令时问题
default-time-zone = +08:00

# ============================================================
#  连接与线程
# ============================================================
# 根据业务并发量调整；中型系统 500~2000 为宜
max_connections = 500
max_connect_errors = 100000
# 线程缓存，减少频繁创建/销毁开销（建议 = max_connections * 0.1~0.2 取整）
thread_cache_size = 64

# 空闲连接回收（秒）— 生产环境不宜过长，避免连接池泄漏堆积
wait_timeout = 600
interactive_timeout = 1800

# 单个连接允许的最大数据包
max_allowed_packet = 64M

# ============================================================
#  InnoDB 核心参数
# ============================================================
# 缓冲池大小 — 生产环境建议物理内存的 60%~75%
# 此处以 4GB 内存服务器为例设为 2G；8GB 机器建议 4G~6G
innodb_buffer_pool_size = 2G
# 缓冲池实例数 — 减少并发锁竞争，通常 = CPU 核心数或 buffer_pool_size(GB) 取较大值
innodb_buffer_pool_instances = 4

# 事务提交刷盘策略 — 1 = 每次事务 fsync，保证最强持久性（ACID）
innodb_flush_log_at_trx_commit = 1
# 直接 I/O，绕过 OS 缓存，避免双重缓冲
innodb_flush_method = O_DIRECT

# Redo Log 容量（MySQL 8.0.30+ / 8.4 使用此参数替代 innodb_log_file_size）
# 生产建议 1G~4G，越大 checkpoint 压力越小，但崩溃恢复时间越长
innodb_redo_log_capacity = 2G

# Redo Log 缓冲 — 大事务场景适当增大
innodb_log_buffer_size = 64M

# I/O 吞吐能力（SSD 建议值；HDD 请用 200/200/400）
innodb_io_capacity = 2000
innodb_io_capacity_max = 4000

# 每个表独立表空间 — 生产必须开启，便于空间回收与迁移
innodb_file_per_table = ON

# 刷脏页后台线程数（SSD 可适当增大）
innodb_page_cleaners = 4

# 锁等待超时（秒）
innodb_lock_wait_timeout = 30

# 打印所有死锁信息到错误日志 — 生产排障必备
innodb_print_all_deadlocks = ON

# 变更缓冲占 buffer pool 比例（默认 25%，写多场景可适当增大）
innodb_change_buffer_max_size = 25

# 自适应哈希索引 — MySQL 8.4 默认开启，保持不变
innodb_adaptive_hash_index = ON

# ============================================================
#  排序与临时表
# ============================================================
sort_buffer_size = 4M
join_buffer_size = 4M
read_buffer_size = 2M
read_rnd_buffer_size = 4M

tmp_table_size = 64M
max_heap_table_size = 64M

# ============================================================
#  Binlog 与复制就绪
# ============================================================
server-id = 1

# Binlog 文件路径
log_bin = /var/log/mysql/mysql-bin

# Binlog 格式 — ROW 最安全，生产默认
binlog_format = ROW

# Binlog 与 Redo 同步刷盘 — 1 = 每次事务同步，保证主从不丢数据
sync_binlog = 1

# Binlog 保留时长（秒）— 7 天
binlog_expire_logs_seconds = 604800

# 单个 Binlog 文件大小上限（默认 1G，生产可调大减少切换）
max_binlog_size = 512M

# 记录 Rows Query 事件 — 便于审计与 pt-query-digest 分析
binlog_rows_query_log_events = ON

# GTID — 生产建议预开启，方便未来搭建主从/MGR
gtid_mode = ON
enforce_gtid_consistency = ON

# 从库只读（单实例无影响，切主从时防止误写）
# read_only = ON
# super_read_only = ON

# ============================================================
#  日志配置
# ============================================================
# 错误日志
log_error = /var/log/mysql/error.log
log_error_verbosity = 2

# 慢查询日志 — 生产必须开启
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2
# 记录未使用索引的查询
log_queries_not_using_indexes = ON
# 记录管理语句（ALTER TABLE、OPTIMIZE 等）
log_slow_admin_statements = ON
# 记录从库慢查询
log_slow_replica_statements = ON

# 通用日志 — 生产环境关闭，仅在排查问题时临时开启
general_log = 0

# ============================================================
#  Performance Schema
# ============================================================
# 生产开启，用于诊断性能瓶颈（内存开销约 200~500MB）
performance_schema = ON

# ============================================================
#  安全与认证
# ============================================================
# 禁用 DNS 反解析 — 避免连接延迟与 DNS 故障影响
skip-name-resolve

# MySQL 8.4 默认认证插件 caching_sha2_password，无需显式声明
# 如有旧客户端需要 mysql_native_password，仅在确认安全风险后开启：
# mysql_native_password = ON

# 禁止 LOCAL INFILE — 防止任意文件读取攻击
local_infile = OFF

# ============================================================
#  其他优化
# ============================================================
# 预分配表定义缓存（减少打开表操作开销）
table_open_cache = 4000
table_definition_cache = 2000

# 开启优化器跟踪（按需临时开启，默认关闭）
# optimizer_trace = enabled=on
