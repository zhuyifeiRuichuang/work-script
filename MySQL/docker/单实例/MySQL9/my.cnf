[mysqld]
# --- 基础优化 ---
port = 3306
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
skip-name-resolve

# --- 内存与连接优化 ---
innodb_buffer_pool_size = 2G            # 容器内存限制的 50-70%
innodb_buffer_pool_instances = 2        # buffer_pool > 1G 时建议 2~4 实例，减少并发争用
max_connections = 500
max_allowed_packet = 256M               # 支持大事务和批量导入
thread_cache_size = 16                  # 减少高并发下线程创建开销
table_open_cache = 4000                 # 避免频繁打开/关闭表

# --- InnoDB 存储引擎优化 ---
innodb_log_buffer_size = 16M
innodb_flush_log_at_trx_commit = 1      # 生产环境必须设为 1，确保 ACID
innodb_flush_method = O_DIRECT          # 避免双缓冲，提升 IO 性能
innodb_file_per_table = 1               # 每表独立表空间，便于空间回收
innodb_io_capacity = 2000               # SSD 建议值
innodb_io_capacity_max = 4000           # SSD 建议值
innodb_read_io_threads = 4              # 多线程读 IO
innodb_write_io_threads = 4             # 多线程写 IO

# --- 生产安全与可靠性 ---
sql_mode = ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
server-id = 1
log-bin = mysql-bin                     # 开启二进制日志，用于备份和主从复制
sync_binlog = 1                         # 与 innodb_flush_log_at_trx_commit=1 双保险，防止崩溃时数据不一致
binlog_expire_logs_seconds = 604800     # binlog 保留 7 天

# --- 慢查询日志 ---
slow_query_log = 1
long_query_time = 2
slow_query_log_file = /var/log/mysql/slow.log

# --- 错误日志 ---
log_error = /var/log/mysql/error.log
log_error_verbosity = 2                 # 1=errors, 2=errors+warnings, 3=errors+warnings+info
