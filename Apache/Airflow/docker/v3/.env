
# ===================== 核心必配项 =====================
# 1. Airflow 加密密钥（必须生成！执行下方命令生成后替换）
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=1w6yM05RHY-rpoDYVMAj8rBRInQXCoyAYJ-clTB6dmo=

# 2. Airflow 容器 UID（Linux：执行 id -u 获取，Windows/macOS 保持 50000）
AIRFLOW_UID=50000
# root用户运行可用0
# AIRFLOW_UID=0

# 3. JWT 认证密钥（API 认证用，建议自定义随机字符串）
# AIRFLOW__API_AUTH__JWT_SECRET=your_custom_jwt_secret_here
# AIRFLOW__API_AUTH__JWT_ISSUER=airflow_prod

# ===================== 可选配置项 =====================
# 自定义 Airflow 镜像（默认：apache/airflow:3.2.0） 
# AIRFLOW_IMAGE_NAME=apache/airflow:3.2.0

# Airflow 项目根目录（默认当前目录，可自定义绝对路径）
# AIRFLOW_PROJ_DIR=.

# 管理员账号密码（默认：airflow/airflow，生产需修改）
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# 临时安装的 PIP 依赖（仅测试用，多个依赖用空格分隔）
# _PIP_ADDITIONAL_REQUIREMENTS=pandas==2.1.0 requests==2.31.0

# 环境文件路径（默认当前目录 .env）
# ENV_FILE_PATH=.env

# ===================== 生产环境建议调整项（需同步改 compose.yaml） =====================
# 以下配置需在 compose.yaml 中修改，此处仅备注
# AIRFLOW__CORE__LOAD_EXAMPLES: 'false'          # 关闭示例 DAG
# AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION: 'true' # 新建 DAG 默认暂停
# AIRFLOW__CORE__EXECUTION_API_SERVER_URL: 'http://airflow-apiserver:8080/execution/' # 保持默认